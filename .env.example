# 로컬 개발용 환경변수 보기.
#
#   cp .env.example .env     하고 값을 채운다
#   .env 는 .gitignore 가 막는다. 이 파일(.example)만 커밋된다.
#
# 배포(Render)에서는 .env 를 쓰지 않는다. Environment 탭에 직접 넣는다.

# --- 인증 (배포 시 필수) ---
# 공개 인터넷에 올리면 반드시 설정한다. 없으면 누구나 가짜 데이터를 밀어넣는다.
PEBBLE_DEVICE_TOKEN=
PEBBLE_APP_TOKEN=

# --- 데이터베이스 ---
# 비워두면 로컬 SQLite. Render 가 자동으로 채워준다.
DATABASE_URL=

# --- LLM 해석 (선택) ---
# 비워두면 규칙 사전으로 돈다. 서비스는 키 없이도 동작한다.
#
#   gemini     https://aistudio.google.com/apikey     (무료 티어로 충분)
#   anthropic  https://console.anthropic.com
PEBBLE_LLM_PROVIDER=
PEBBLE_LLM_KEY=
PEBBLE_LLM_MODEL=
